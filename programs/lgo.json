    {"if": {"in": "lgo_required_mba"}, "then": "LGO Required MBA"},
    {"if": {"in": "python"},           "then": "Python"},
    {"if": {"in": "thesis"},           "then": "Thesis"},
    {"program": true},
    {"if": {"dept": ["Course 15"]},    "then": "MBA Elective"}
  ],

  "requirements": [
    {"id": "mba_core",  "group": "MBA", "label": "MBA Core",             "type": "sum", "pool": ["MBA Core"],         "min_units": 36},
    {"id": "mba_lgo",   "group": "MBA", "label": "LGO Required MBA",     "type": "sum", "pool": ["LGO Required MBA"], "min_units": 71},
    {"id": "mba_elec",  "group": "MBA", "label": "MBA Free Electives",   "type": "sum", "pool": ["MBA Elective"],     "min_units": 49},
    {"id": "mba_total", "group": "MBA", "label": "MBA Total Coursework", "type": "sum", "pool": ["MBA Core", "LGO Required MBA", "MBA Elective"],
     "min_units": 156, "headline": true, "summary": "MBA"},
    {"program": true},
    {"id": "thesis", "group": "Thesis & extras", "label": "SM Thesis",       "type": "sum",   "pool": ["Thesis"], "min_units": 24, "summary": "Thesis"},
    {"id": "python", "group": "Thesis & extras", "label": "Python (6.S090)", "type": "count", "pool": ["Python"], "min_courses": 1},
    {"id": "design", "group": "Thesis & extras", "label": "LGO Design",      "type": "count", "pool": ["LGO Design"], "or_in": "design_approved", "min_courses": 1}
  ],

